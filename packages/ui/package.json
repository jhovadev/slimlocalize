{
  "name": "@slimlocalize/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared SolidJS design system and workspace UI for SlimLocalize",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/app.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./uno": "./uno.config.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@slimlocalize/client-sdk": "workspace:*",
    "@slimlocalize/platform": "workspace:*",
    "solid-js": "1.9.19"
  },
  "devDependencies": {
    "@solidjs/router": "1.0.3",
    "@solidjs/testing-library": "0.8.10",
    "@testing-library/jest-dom": "6.9.1",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "unocss": "66.13.0",
    "vite": "8.3.8",
    "vite-plugin-solid": "2.11.16",
    "vitest": "5.1.0"
  }
}
